# Optional: a form endpoint that accepts a JSON POST and returns 2xx on success.
# When omitted, the form produces a review panel with WhatsApp / Instagram / copy
# fallbacks and clearly states that nothing has been sent.
VITE_COACHING_ENDPOINT=

# Optional: adds a "Send by email" fallback to the review panel. Only set this if
# the address is confirmed and monitored. Leave blank to omit the mailto link.
VITE_CONTACT_EMAIL=
